// Development build: separate bundle id and name so its Accessibility permission
// never collides with the release app on the same Mac.
PRODUCT_BUNDLE_IDENTIFIER = com.huyly.skey.dev
PRODUCT_NAME = SKey Dev

// Default: ad-hoc signature (builds without an Apple ID). Accessibility permission
// is then lost on every rebuild. Copy Local.xcconfig.example to Local.xcconfig and
// fill in your Team ID to sign with your free Apple Development certificate instead.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
