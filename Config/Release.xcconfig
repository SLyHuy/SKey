// Release build: no certificate. The app is ad-hoc signed ("-"), which Apple Silicon
// requires to run at all; users grant Accessibility themselves (see README).
PRODUCT_BUNDLE_IDENTIFIER = com.huyly.skey
PRODUCT_NAME = SKey

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO
